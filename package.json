{
  "name": "chromium-clean-markdown",
  "version": "0.2.0",
  "description": "Turn web pages into clean, noise-free Markdown using Chromium's AnnotatedPageContent over CDP.",
  "author": "Paul Irish",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulirish/chromium-clean-markdown.git"
  },
  "type": "module",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "chromium-clean-markdown": "dist/index.mjs",
    "clean-md": "dist/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./decode": {
      "types": "./dist/decode.d.mts",
      "default": "./dist/decode.mjs"
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"test/!(*cdp).test.ts\"",
    "test:cdp": "node --test test/cdp.test.ts && node --test test/turndown-cdp.test.ts",
    "test:compatibility": "RUN_ALL_TURNDOWN_TESTS=1 node --test test/turndown-cdp.test.ts",
    "test": "pnpm run test:unit && pnpm run test:cdp",
    "preflight": "pnpm typecheck && pnpm run build && pnpm test",
    "update-proto": "node src/update-proto.ts",
    "build": "tsdown src/index.ts src/decode.ts --dts --format esm --out-dir dist",
    "prepack": "pnpm run build"
  },
  "optionalDependencies": {
    "playwright": "1.65.1"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "tsdown": "^0.23.7",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^7.0.2"
  },
  "tsdown": {
    "deps": {
      "onlyBundle": [
        "@bufbuild/protobuf"
      ]
    }
  },
  "packageManager": "pnpm@10.30.3"
}
