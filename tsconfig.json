{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*",
    "test/**/*"
  ],
  "exclude": [
    "scripts/proto/common_quality_data_pbjs.js",
    "submodules/**/*"
  ]
}
